FROM node:20-slim

WORKDIR /app

# Copy package files
COPY package.json package-lock.json ./

# Install all dependencies (need @solana/web3.js and @supabase/supabase-js)
RUN npm ci

# Copy only the grinder script and tsconfig
COPY scripts/vanity-grind.ts ./scripts/
COPY tsconfig.json ./

# Run with tsx
CMD ["npx", "tsx", "scripts/vanity-grind.ts"]
