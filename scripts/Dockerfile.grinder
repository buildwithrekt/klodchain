FROM node:20-alpine

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm ci --only=production

# Copy grinder script
COPY scripts/vanity-grind.ts ./scripts/
COPY tsconfig.json ./

# Install tsx for running TypeScript
RUN npm install -g tsx

# Run the grinder
CMD ["tsx", "scripts/vanity-grind.ts"]
