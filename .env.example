# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Solana RPC (optional - defaults to public mainnet)
# Recommended: Use Helius, QuickNode, or Alchemy for production
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# PumpPortal API (for real-time trade data)
# Get your API key at https://pumpportal.fun
NEXT_PUBLIC_PUMPPORTAL_API_KEY=your_pumpportal_api_key

# Birdeye API (for token data - price, market cap, etc.)
# Get your API key at https://birdeye.so
BIRDEYE_API_KEY=your_birdeye_api_key
